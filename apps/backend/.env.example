# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_VERSION=0.1.0

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scribecode?schema=public

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Public URL of the frontend (used for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Sessions
SESSION_COOKIE_NAME=scribe_session
SESSION_TTL_HOURS=720

# GitHub integration
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:4000/api/v1/auth/github/callback
# Leave GITHUB_CLIENT_ID/SECRET blank to disable the OAuth flow and use a
# personal access token instead (POST /api/v1/auth/pat).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
GITHUB_SCOPES=read:user user:email repo

# LLM integration (provider-agnostic, OpenAI-compatible endpoints)
# LLM_PROVIDER: mock | openai | deepseek. "mock" runs fully offline with
# deterministic output, so a fresh checkout works without any API key.
LLM_PROVIDER=mock

# API keys. DeepSeek reads DEEPSEEK_API_KEY (falling back to LLM_API_KEY);
# the openai provider reads LLM_API_KEY.
LLM_API_KEY=
DEEPSEEK_API_KEY=

# Optional overrides — leave blank to use the provider defaults:
#   openai   -> https://api.openai.com/v1  (gpt-4o-mini)
#   deepseek -> https://api.deepseek.com   (deepseek-chat)
LLM_BASE_URL=
LLM_MODEL=

# Maximum tokens in a model response, and whether to request guaranteed-JSON
# output on structured calls.
LLM_MAX_TOKENS=4096
LLM_JSON_MODE=true
